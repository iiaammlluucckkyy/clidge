# CLIDGE Environment Configuration Template
# Option A: Copy this file to .env (local) or add in Vercel/Netlify Environment Variables
# Option B: Paste your Firebase keys directly in src/services/firebaseConfig.js

# 1. Firebase Configuration (from Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2. App Owner's Secret Faculty Access Key (strangers cannot create Faculty accounts without this)
VITE_FACULTY_ACCESS_KEY=CLIDGE-ADMIN-SECURE-2026
VITE_ADMIN_PROVISION_SECRET=CLIDGE-ADMIN-SECURE-2026

# 3. Optional Flask Backend URL (leave empty to use Serverless Cloud Firestore directly)
VITE_FLASK_API_URL=
