# CLIDGE Environment Configuration Template
# Copy this file to .env and insert your project credentials

# Firebase Authentication & Firestore Config
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# Optional Python Flask API Gateway URL (Local: http://localhost:5000/api | Production: https://clidge-api.onrender.com/api)
VITE_FLASK_API_URL=http://localhost:5000/api

# Trusted Administrative Secret for Provisioning Teacher Accounts
VITE_ADMIN_PROVISION_SECRET=your_admin_provision_secret_key

# Institutional White-Label Branding (Optional - defaults to MEC CSE)
VITE_INSTITUTION_NAME=Muthayammal Engineering College
VITE_INSTITUTION_CODE=MEC
VITE_CAMPUS_DEPARTMENT=Department of Computer Science & Engineering
VITE_PLATFORM_NAME=CLIDGE
VITE_CAMPUS_TITLE=Smart Campus Presence System
VITE_SUPPORT_EMAIL=support@clidge.edu.in
