rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isFaculty() {
      return hasProfile() && userProfile().role == 'teacher';
    }

    function sameCollege(collegeCode) {
      return hasProfile() && userProfile().collegeCode == collegeCode;
    }

    function sessionCollegeCode(sessionCode) {
      return get(/databases/$(database)/documents/sessions/$(sessionCode)).data.collegeCode;
    }

    // ===============================================================
    // 1. USERS: Read and write ONLY own profile; role & collegeCode cannot be escalated
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ['student', 'teacher']
                    && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'role', 'collegeCode', 'createdAt']);

      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.collegeCode == resource.data.collegeCode;

      allow delete: if false;
    }

    // ===============================================================
    // 2. COLLEGES: Single-doc lookup allowed so student signup can verify 6-char code
    // ===============================================================
    match /colleges/{collegeCode} {
      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
                    && request.resource.data.code == collegeCode
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.keys().hasAll(['code', 'name', 'createdBy', 'createdAt']);

      allow update: if isFaculty() && sameCollege(collegeCode);
      allow delete: if false;
    }

    // ===============================================================
    // 3. ZONES (Campus buildings tapped on Satellite map): Scoped strictly per college
    // ===============================================================
    match /zones/{zoneId} {
      allow read: if sameCollege(resource.data.collegeCode);

      allow create: if isFaculty()
                    && sameCollege(request.resource.data.collegeCode)
                    && request.resource.data.keys().hasAll(['name', 'latitude', 'longitude', 'radius', 'collegeCode', 'createdBy']);

      allow update, delete: if isFaculty()
                            && sameCollege(resource.data.collegeCode);
    }

    // ===============================================================
    // 4. EVENTS: Scoped strictly per college; only that college's faculty can create/delete
    // ===============================================================
    match /events/{eventId} {
      allow read: if sameCollege(resource.data.collegeCode);

      allow create: if isFaculty()
                    && sameCollege(request.resource.data.collegeCode)
                    && request.resource.data.teacherId == request.auth.uid
                    && request.resource.data.keys().hasAll(['title', 'venue', 'date', 'description', 'collegeCode', 'teacherId']);

      allow update, delete: if isFaculty()
                            && sameCollege(resource.data.collegeCode);
    }

    // ===============================================================
    // 5. LOCATION SESSIONS & REAL-TIME STUDENT LOCATIONS: Scoped strictly per college
    // ===============================================================
    match /sessions/{sessionCode} {
      allow read: if sameCollege(resource.data.collegeCode);

      allow create: if isFaculty()
                    && sameCollege(request.resource.data.collegeCode)
                    && request.resource.data.facultyUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['sessionCode', 'collegeCode', 'facultyUid', 'active', 'createdAt']);

      allow update, delete: if isFaculty()
                            && sameCollege(resource.data.collegeCode);

      match /locations/{studentUid} {
        // Only the student themselves or faculty from the SAME college can view
        allow read: if sameCollege(sessionCollegeCode(sessionCode))
                    && (isOwner(studentUid) || isFaculty());

        // Students can write ONLY their own location, ONLY into their own college's active session
        allow create, update: if isOwner(studentUid)
                              && sameCollege(sessionCollegeCode(sessionCode))
                              && request.resource.data.studentUid == request.auth.uid
                              && request.resource.data.collegeCode == userProfile().collegeCode
                              && get(/databases/$(database)/documents/sessions/$(sessionCode)).data.active == true;

        // Students can mark/remove their own location entry
        allow delete: if isOwner(studentUid) && sameCollege(sessionCollegeCode(sessionCode));
      }
    }

    // ===============================================================
    // 6. EVENT PARTICIPANTS & ATTENDANCE (Optional event RSVP tracking)
    // ===============================================================
    match /eventParticipants/{participantId} {
      allow read: if sameCollege(resource.data.collegeCode);
      allow create: if isSignedIn()
                    && request.resource.data.studentId == request.auth.uid
                    && sameCollege(request.resource.data.collegeCode);
      allow update: if isSignedIn() && sameCollege(resource.data.collegeCode)
                    && (request.auth.uid == resource.data.studentId || isFaculty());
      allow delete: if isSignedIn() && request.auth.uid == resource.data.studentId;
    }

    match /attendanceRecords/{recordId} {
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || (isFaculty() && sameCollege(resource.data.collegeCode)));
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isFaculty() && sameCollege(resource.data.collegeCode);
    }
  }
}
